# Compiled third-party references; keep source, licenses, and provenance.
/third_party/**/*.o
/third_party/**/*.obj
/third_party/**/*.a
/third_party/**/*.so
/third_party/**/*.so.*
/third_party/**/*.dylib
/third_party/**/*.dll
/third_party/**/*.mod
/third_party/**/CMakeFiles/
/third_party/**/CMakeCache.txt

# Local environment settings; example templates may be committed.
.env
.env.*
!.env.example
!.env.*.example
!.env.sample
!.env.template

# Editor/OS temporary files and package-manager logs
.DS_Store
Thumbs.db
*.swp
*.swo
*~
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Intentionally track status documents, ISAE progress history/scopes, tests
# and fixtures, examples, third-party source, and public deployment assets
