# Raw validation archives stay local or in external artifact storage.
# Keep archive-index.json, reference catalogs, summaries, and small fixtures.
/docs/validation/**/*.zip
/docs/validation/**/*.tar
/docs/validation/**/*.tar.gz
/docs/validation/**/*.tgz

