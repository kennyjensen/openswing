  "findings": [
    {
      "id": "ASWING_GEOMETRY_LAW",
      "classification": "documented and current implementation consistent at source level",
      "finding": "Equations 154\u2013158 prescribe theta-interpolated beam position, wind-aligned force/control points and a rotated control-point normal. Equation 67 uses the force-point velocity; equations 200/203 constrain control-point velocity. Current source retains this distinction. An internal fresh residual does not establish historical geometry identity."
    },
    {
      "id": "SELF_CORE",
      "classification": "documented ASWING policy with an unresolved self convention",
      "finding": "Same-physical-surface finite core is zero; W does not affect a single surface. No explicit curved-bound self term or own-bound diagonal prescription was found in the inspected ASWING theory/manual/version notes. Current code excludes its own straight bound segment even when the force point lies off that segment; historical ASWING equivalence is unproven."
    },
    {
      "id": "JVL_CURVATURE",
      "classification": "adjacent-code evidence, not historical ASWING policy",
      "finding": "JVL 2.20 derives a shallow-curvature vortex-sheet patch self velocity with positive Gamma times binormal sign. Its area is the patch area, not airfoil cross-section area; no thickness is needed. Endpoints lack a stated discrete closure. The downloadable JVL 2.16 VVOR routine has a small same-component core and diagonal omission, so the newer paper must not be treated as exact downloadable code or ASWING behavior."
    },
    {
      "id": "SAVED_ANALOGUE",
      "classification": "bounded exploratory result supplied by parent; no independent physics here",
      "finding": "With fixed original Gamma and declared area=chord*ds, the positive drag increment is too small to explain the saved near/far gap, and worsens agreement. Tip curvature and force-point offset violate the derivation assumptions. Reject this direct analogue as the main correction; do not change production code on this evidence."
    },
    {
      "id": "NEXT_DISTINCTION",
      "classification": "source-supported identity audit, not a settings sweep",
      "finding": "Prioritize independent equation-154\u2013158 geometry/collocation reconstruction from saved nodal arrays and exact source interpolation samples. Separate force-point placement from control-point law and endpoint geometry. Historical node arrays, spline endpoint conditions and pointwise/Fourier setting are unestablished; do not guess them from a closer coefficient."
    }
  ],
  "curvature_formula": {
    "ell": "ell_i = b_i - a_i, oriented in the direction of positive right-hand Gamma",
    "kappa": "kappa_i = (cross(ell_{i-1},ell_i) + cross(ell_i,ell_{i+1})) / (2*norm(ell_i)^3)",
    "delta_velocity": "delta_v_i = Gamma_i*kappa_i/(8*pi) * log((sqrt(1+(A_i/norm(ell_i)^2)^2)+1)/(sqrt(1+(A_i/norm(ell_i)^2)^2)-1))",
